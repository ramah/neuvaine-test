---
import data from '../data/prague.json';
import '../styles/base.css';
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow"><title>Neuvaine de 9 heures</title></head><body>
<header><a class="back" href={import.meta.env.BASE_URL}>← Toutes les neuvaines</a><h1 id="t"></h1><div class="sub" id="d"></div></header>
<main>
<div id="welcome">
<h2>Ta neuvaine à toi</h2>
<div class="card">9 heures d'affilée, une prière à chaque heure. Ta première heure est celle où tu commences : si tu arrives en retard sur une autre personne, ce n'est pas grave, ton parcours ne dépend que de toi.</div>
<div class="row"><button class="btn" id="go">Commencer maintenant</button></div>
<div class="tim"><label for="st">ou à une heure précise</label><input type="time" id="st"><button class="btn alt" id="setst">Valider</button></div>
</div>
<div id="mine" hidden>
<h2>Ma neuvaine</h2>
<div class="rem"><span class="dot"></span><div><b id="stt"></b><span id="sts"></span></div></div>
<div id="slots"></div>
<div class="row"><button class="btn alt" id="reset">Recommencer</button></div>
</div>
<h2>Prière à dire à chaque heure</h2>
<div class="player"><div class="lab">Écouter la prière de l'heure</div><audio id="au1" controls preload="none"></audio><div class="sub">Un silence de 12 secondes laisse le temps de formuler sa demande après chaque invocation. L'action de grâce suit.</div></div>
<div class="card" id="prayer"></div>
<div class="lab" id="th" style="margin:18px 0 6px"></div>
<div class="card" id="thanks"></div>
<p class="note">Page de test, hors application. Les textes sont ceux reçus, sans modification. Chaque heure, on dit les trois invocations puis la prière d'action de grâce. Ton heure de départ et les heures cochées restent sur ton téléphone seulement : rien n'est envoyé, il n'y a pas de compte. Voix : Piper, modèle fr_FR-siwis-medium (données SIWIS, Université d'Édimbourg, licence CC BY 4.0), voix synthétique ; les guillemets ne sont pas lus.</p>
</main>
<script is:inline define:vars={{ D: data, B: import.meta.env.BASE_URL }}>
const base=B.replace(/\/$/,'')+'/audio/',H=3600000,pad=n=>String(n).padStart(2,'0');
document.getElementById('t').textContent=D.title;document.getElementById('d').textContent=D.sub;
document.getElementById('au1').src=base+'prague-heure.m4a';
const pr=document.getElementById('prayer');
D.prayers.forEach(t=>{const p=document.createElement('div');p.textContent=t;p.style.marginTop='10px';pr.appendChild(p);const c=document.createElement('div');c.textContent=D.cue;c.style.cssText='font:italic 14px system-ui,sans-serif;color:#6b6258;margin-top:4px';pr.appendChild(c)});
document.getElementById('th').textContent=D.thanks_title.charAt(0)+D.thanks_title.slice(1).toLowerCase();
const th=document.getElementById('thanks');D.thanks.forEach(t=>{const p=document.createElement('div');p.textContent=t;p.style.marginTop='10px';th.appendChild(p)});
const KEY='pg2';let S=null;try{S=JSON.parse(localStorage.getItem(KEY))}catch(e){}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}}
const hm=ms=>{const d=new Date(ms);return pad(d.getHours())+':'+pad(d.getMinutes())};
const ord=i=>i===0?'1re':(i+1)+'e';
function dur(ms){const m=Math.max(1,Math.ceil(ms/60000));return m<60?m+' min':Math.floor(m/60)+' h '+pad(m%60)}
function begin(ms){S={start:ms,done:[]};save();render()}
function render(){
const w=document.getElementById('welcome'),m=document.getElementById('mine');
if(!S){w.hidden=false;m.hidden=true;return}
w.hidden=true;m.hidden=false;
const now=Date.now(),cur=now<S.start?-1:Math.min(Math.floor((now-S.start)/H),9);
const box=document.getElementById('slots');box.innerHTML='';
for(let i=0;i<9;i++){const s=S.start+i*H;const row=document.createElement('label');row.className='slot';
const cb=document.createElement('input');cb.type='checkbox';cb.checked=S.done.includes(i);
cb.onchange=()=>{S.done=cb.checked?[...new Set([...S.done,i])]:S.done.filter(x=>x!==i);save();render()};
const b=document.createElement('b');b.textContent=ord(i)+' heure';const t=document.createElement('span');
const tomorrow=new Date(s).toDateString()!==new Date(S.start).toDateString();t.textContent=hm(s)+(tomorrow?' (le lendemain)':'');
row.append(cb,b,t);
if(cb.checked)row.classList.add('done');
else if(i===cur)row.classList.add('now');
else if(i<cur){row.classList.add('done');t.textContent+=' · passée'}
box.appendChild(row)}
const doneN=S.done.length,tt=document.getElementById('stt'),ss=document.getElementById('sts');
if(doneN===9){tt.textContent='Neuvaine terminée';ss.textContent='Les 9 heures sont faites. Merci d\'avoir prié.'}
else if(cur<0){tt.textContent='Ta première prière approche';ss.textContent='Dans '+dur(S.start-now)+' ('+hm(S.start)+').'}
else if(cur>=9){tt.textContent='Les 9 heures sont écoulées';ss.textContent=doneN+' heure'+(doneN>1?'s':'')+' sur 9 cochée'+(doneN>1?'s':'')+'. Tu peux recommencer quand tu veux.'}
else if(!S.done.includes(cur)){tt.textContent=ord(cur)+' heure sur 9 : c\'est l\'heure de prier';ss.textContent='Depuis '+hm(S.start+cur*H)+'. Coche la case une fois la prière dite.'}
else{tt.textContent=ord(cur)+' heure faite';ss.textContent=cur<8?'Prochaine prière à '+hm(S.start+(cur+1)*H)+', dans '+dur(S.start+(cur+1)*H-now)+'.':'Dernière heure faite.'}
}
document.getElementById('go').onclick=()=>begin(Date.now());
document.getElementById('setst').onclick=()=>{const v=document.getElementById('st').value;if(!v)return;const [h,mi]=v.split(':').map(Number);const d=new Date();d.setHours(h,mi,0,0);begin(d.getTime())};
document.getElementById('reset').onclick=()=>{if(confirm('Recommencer ta neuvaine ? Les heures cochées seront effacées.')){S=null;try{localStorage.removeItem(KEY)}catch(e){}render()}};
render();setInterval(render,30000);
</script></body></html>
