---
import '../styles/base.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow"><title>Neuvaines : test</title></head><body>
<header><h1>Neuvaines</h1><div class="sub">Page de test : des neuvaines reçues, rangées pour être suivies</div></header>
<main>
<div class="list">
<a class="item" href={base + '/medaille/'}><b>Notre-Dame de la Médaille Miraculeuse</b><span>Neuvaine de 9 jours, du 19 au 27 novembre</span><em id="s1"></em></a>
<a class="item" href={base + '/enfant-jesus-prague/'}><b>Enfant Jésus de Prague</b><span>Neuvaine de 9 heures : une prière à dire à chaque heure</span><em id="s2">À commencer quand tu veux</em></a>
</div>
<p class="note">Les textes sont ceux reçus, sans modification. Chaque neuvaine a son audio, avec une voix synthétique. Pages non référencées, à supprimer après les essais.</p>
</main>
<script is:inline>
const start=new Date('2026-11-19T00:00:00');const n=new Date();const idx=Math.floor((new Date(n.getFullYear(),n.getMonth(),n.getDate())-start)/86400000)+1;
document.getElementById('s1').textContent=idx<1?'Pas encore commencée':idx>9?'Terminée, à refaire quand tu veux':'Aujourd\'hui : jour '+idx+' sur 9';
</script></body></html>
